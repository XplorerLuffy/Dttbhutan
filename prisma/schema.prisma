// Bhutan Tour Booking Platform — data model
// Covers: multi-vendor marketplace (guides, hotels, transport),
// bookings/availability, reviews, payments, and the GPS tracking module
// (device-to-vehicle-to-trip mapping, position log, mileage reports).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Migrations need a direct (non-pooled) connection: `prisma migrate
  // deploy` takes a session-level advisory lock, which a PgBouncer
  // transaction-mode pooler (Supabase's default DATABASE_URL, port 6543)
  // can silently hang forever on, since each statement may land on a
  // different backend connection. DATABASE_URL stays pooled for the app's
  // own serverless queries; DIRECT_URL bypasses the pooler for migrations
  // only. When both point at the same plain Postgres server (local dev),
  // they're identical.
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Identity & roles
// ---------------------------------------------------------------------------

enum Role {
  TRAVELER
  GUIDE
  HOTEL_OPERATOR
  TRANSPORT_OPERATOR
  ADMIN
}

enum VendorStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  /// The bcrypt hash from before Supabase Auth owned passwords.
  ///
  /// Kept, not dropped: it is what the import script feeds to Supabase so the
  /// existing accounts keep their current passwords instead of everyone being
  /// made to reset. Nothing reads it to sign anyone in any more. Safe to drop
  /// in a later migration once every row has an authId and the import has not
  /// needed re-running for a while.
  passwordHash String?
  name         String
  phone        String?
  role         Role     @default(TRAVELER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  /// This account's row in Supabase's `auth.users`.
  ///
  /// The profile stays here rather than moving into auth.users, because
  /// User.id is a cuid that ten tables already point at with live data —
  /// bookings, reviews, guide profiles, messages. Re-keying all of them to
  /// Supabase's uuids would be a large migration that bought nothing. So
  /// Supabase owns the credentials and the session, this row owns who the
  /// person is to the agency, and authId is the join between them.
  ///
  /// Nullable only so the column could be added to a table that already had
  /// rows; every account gets one when it is imported or registered.
  authId String? @unique @db.Uuid

  /// When this account's password last changed. Sessions are stateless JWTs,
  /// so there is nothing to delete server-side when someone changes their
  /// password — without this, a token minted under the old password keeps
  /// working for the rest of its fourteen days. getCurrentUser compares the
  /// token's issued-at against this and refuses anything older, which is what
  /// makes "change the password" actually end the sessions that knew it.
  /// Null means it has never been changed, and every token is accepted.
  passwordChangedAt DateTime?

  /// A one-time "set your password" link, for a guide an admin has approved.
  ///
  /// Guides apply without an account — only people the admin accepts get a
  /// login. Approving one emails a link carrying a random token; only its
  /// SHA-256 is stored here, so a copy of the database can't be used to take
  /// over an account that hasn't been claimed yet. Opening the link and
  /// choosing a password creates the Supabase login, links it through
  /// authId, and clears both columns. Null once used, or if never issued.
  inviteTokenHash String?   @unique
  inviteExpiresAt DateTime?

  guideProfile       GuideProfile?
  hotel              Hotel?
  transportOperator  TransportOperator?
  bookings           Booking[]
  reviews            Review[]
  sentMessages       Message[]
  customTourRequests CustomTourRequest[]
  contactMessages    ContactMessage[]
  contactReplies     ContactReply[]
}

// ---------------------------------------------------------------------------
// Destinations — Bhutan's 20 dzongkhags (districts). Hotels sit in one;
// guides can cover several; itinerary days visit one; custom tour requests
// name whichever ones the traveler wants to see.
// ---------------------------------------------------------------------------

enum DzongkhagRegion {
  WEST
  CENTRAL
  EAST
  NORTH
  SOUTH
}

model Destination {
  id          String          @id @default(cuid())
  name        String          @unique // dzongkhag name, e.g. "Paro"
  slug        String          @unique
  region      DzongkhagRegion
  description String?
  /// The text search engines show under the page title (70–160 characters). Falls back to the description.
  metaDescription String?
  highlights  String[] // notable sites/attractions
  photoUrl    String?
  latitude    Float?
  longitude   Float?
  createdAt   DateTime        @default(now())

  hotels             Hotel[]
  guides             GuideProfile[]      @relation("GuideCoverage")
  itineraryDays      ItineraryDay[]
  customTourRequests CustomTourRequest[] @relation("CustomTourDestinations")
}

// ---------------------------------------------------------------------------
// Vendor: Tour Guides
// ---------------------------------------------------------------------------

model GuideProfile {
  id              String       @id @default(cuid())
  userId          String       @unique
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  licenseNumber   String // TCB (Tourism Council of Bhutan) guide license number
  languages       String[]
  specialties     String[] // trekking, cultural, historical, adventure, etc.
  yearsExperience Int          @default(0)
  ratePerDay      Decimal      @db.Decimal(10, 2)
  bio             String?
  /// Search-result description (70–160 characters); a generated one is used when blank.
  metaDescription String?
  photoUrl        String?
  status          VendorStatus @default(PENDING)
  adminNote       String? // reason for rejection/suspension, or verification notes
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  blockedDates       GuideBlockedDate[]
  bookings           Booking[]
  destinations       Destination[]       @relation("GuideCoverage") // dzongkhags this guide covers
  customTourRequests CustomTourRequest[]
}

// Dates a guide has explicitly marked unavailable (holidays, other commitments).
// Actual booking conflicts are computed from Booking date ranges directly.
model GuideBlockedDate {
  id      String       @id @default(cuid())
  guideId String
  guide   GuideProfile @relation(fields: [guideId], references: [id], onDelete: Cascade)
  date    DateTime

  @@unique([guideId, date])
}

// ---------------------------------------------------------------------------
// Vendor: Hotels
// ---------------------------------------------------------------------------

model Hotel {
  id                 String       @id @default(cuid())
  ownerId            String       @unique
  owner              User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name               String
  description        String?
  destinationId      String
  destination        Destination  @relation(fields: [destinationId], references: [id])
  /// Search-result description (70–160 characters); a generated one is used when blank.
  metaDescription    String?
  address            String? // specific address/area within the destination
  latitude           Float?
  longitude          Float?
  amenities          String[]
  photoUrls          String[]
  businessLicenseUrl String?
  status             VendorStatus @default(PENDING)
  adminNote          String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  roomTypes RoomType[]
}

model RoomType {
  id            String   @id @default(cuid())
  hotelId       String
  hotel         Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name          String // e.g. "Deluxe Double", "Suite"
  capacity      Int
  pricePerNight Decimal  @db.Decimal(10, 2)
  totalRooms    Int      @default(1)
  createdAt     DateTime @default(now())

  bookings           Booking[]
  customTourRequests CustomTourRequest[]
}

// ---------------------------------------------------------------------------
// Vendor: Transportation (vehicles + drivers)
// ---------------------------------------------------------------------------

model TransportOperator {
  id                 String       @id @default(cuid())
  ownerId            String       @unique
  owner              User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  businessName       String
  businessLicenseUrl String?
  status             VendorStatus @default(PENDING)
  adminNote          String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  vehicles Vehicle[]
}

enum VehicleType {
  SEDAN
  SUV
  VAN
  BUS
}

model Vehicle {
  id                  String            @id @default(cuid())
  operatorId          String
  operator            TransportOperator @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  type                VehicleType
  capacity            Int
  plateNumber         String            @unique
  driverName          String
  driverLicenseNumber String
  ratePerDay          Decimal           @db.Decimal(10, 2)
  ratePerKm           Decimal?          @db.Decimal(10, 2)
  status              VendorStatus      @default(PENDING)
  adminNote           String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  gpsDevice          GpsDevice?
  bookings           Booking[]
  trips              Trip[]
  customTourRequests CustomTourRequest[]
}

// ---------------------------------------------------------------------------
// Bookings, availability, reviews, payments
// ---------------------------------------------------------------------------

enum BookingType {
  GUIDE
  HOTEL
  VEHICLE
  FLIGHT
  ITINERARY
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model Booking {
  id String @id @default(cuid())

  /// Short, human-quotable booking reference (e.g. DTT-7K3M2Q). Generated on
  /// create — cuids are unreadable over the phone or in an email subject.
  reference      String        @unique
  travelerId     String
  traveler       User          @relation(fields: [travelerId], references: [id], onDelete: Cascade)
  type           BookingType
  status         BookingStatus @default(PENDING)
  startDate      DateTime
  endDate        DateTime
  totalPrice     Decimal       @db.Decimal(10, 2)
  commissionRate Decimal       @default(0.10) @db.Decimal(5, 4) // platform commission, e.g. 0.10 = 10%

  guideId    String?
  guide      GuideProfile? @relation(fields: [guideId], references: [id])
  roomTypeId String?
  roomType   RoomType?     @relation(fields: [roomTypeId], references: [id])
  vehicleId  String?
  vehicle    Vehicle?      @relation(fields: [vehicleId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  review           Review?
  messages         Message[]
  payment          Payment?
  trip             Trip? // only present for VEHICLE bookings
  flightBooking    FlightBooking? // only present for FLIGHT bookings
  itineraryBooking ItineraryBooking? // only present for ITINERARY bookings

  @@index([guideId, startDate, endDate])
  @@index([roomTypeId, startDate, endDate])
  @@index([vehicleId, startDate, endDate])
}

// ---------------------------------------------------------------------------
// Flights
//
// Bhutan has no domestic airline inventory of its own to sell directly —
// this books through a third-party aggregator (Amadeus/Duffel/GDS reseller)
// rather than owning inventory. `aggregatorProvider`/`aggregatorOfferId`
// trace a booking back to that upstream system; `pnr` is what the traveler
// actually needs (their airline reservation code). See
// src/lib/flights/aggregator.ts — this build ships a mock provider behind
// the same interface a real one would implement.
// ---------------------------------------------------------------------------

enum CabinClass {
  ECONOMY
  PREMIUM_ECONOMY
  BUSINESS
  FIRST
}

model FlightBooking {
  id        String  @id @default(cuid())
  bookingId String  @unique
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  origin      String // IATA airport code, e.g. "PBH"
  destination String // IATA airport code, e.g. "BKK"
  departureAt DateTime
  returnAt    DateTime? // null for one-way
  passengers  Int        @default(1)
  cabinClass  CabinClass @default(ECONOMY)

  airline      String
  flightNumber String

  aggregatorProvider String // e.g. "mock", "amadeus", "duffel"
  aggregatorOfferId  String // the offer/fare id returned by the aggregator's search
  pnr                String // airline reservation code returned on ticketing

  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Itineraries — pre-built, agency-authored package tours spanning multiple
// days/destinations, bookable as a single line item. Distinct from a
// CustomTourRequest, which is an inquiry (no fixed itinerary or price yet)
// that the agency turns into a bespoke quote by hand.
// ---------------------------------------------------------------------------

enum ItineraryStatus {
  DRAFT // being built, not visible to travelers
  PUBLISHED
  ARCHIVED
}

enum TripDifficulty {
  EASY
  MODERATE
  CHALLENGING
}

enum ItineraryCategory {
  TREKKING
  CULTURAL
  WILDLIFE
  HONEYMOON
}

model Itinerary {
  id             String            @id @default(cuid())
  title          String
  slug           String            @unique
  summary        String
  /// The text search engines show under the page title (aim for 70–160 characters). Falls back to the summary.
  metaDescription String?
  description    String?
  durationDays   Int
  pricePerPerson Decimal           @db.Decimal(10, 2)
  maxGroupSize   Int?
  difficulty     TripDifficulty    @default(EASY)
  category       ItineraryCategory @default(CULTURAL)
  status         ItineraryStatus   @default(DRAFT)
  coverPhotoUrl  String?
  includes       String[] // e.g. "Licensed guide", "All ground transport", "3-star hotels"
  excludes       String[] // e.g. "International flights", "Visa fee", "Personal expenses"
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  days       ItineraryDay[]
  bookings   ItineraryBooking[]
  departures Departure[]
  lodgings   ItineraryLodging[]
  photos     ItineraryPhoto[]
}

// The trip's photo gallery, in display order. Separate from
// `coverPhotoUrl` because the cover has a different job — it has to work
// cropped to a card and behind a headline — and a gallery shot does not.
model ItineraryPhoto {
  id          String    @id @default(cuid())
  itineraryId String
  itinerary   Itinerary @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  position    Int
  url         String
  caption     String?

  @@index([itineraryId, position])
}

// Where a package's travellers sleep. Held per itinerary rather than per
// day so a property used for three nights is described once and the public
// page can say "3 nights" — the nights are derived from the days pointing
// at it, so the two can never disagree.
//
// Deliberately not the vendor `Hotel` model: these are the properties the
// agency books for its own tours, which may be guesthouses or tented camps
// that will never be listed on the marketplace.
model ItineraryLodging {
  id          String    @id @default(cuid())
  itineraryId String
  itinerary   Itinerary @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  position    Int // display order within the trip
  name        String
  location    String?
  description String?
  photoUrl    String?

  days ItineraryDay[]

  @@index([itineraryId, position])
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
}

model Article {
  id            String        @id @default(cuid())
  title         String
  slug          String        @unique
  category      String // e.g. "Visa & Entry", "SDF Fee", "Festivals & Seasons"
  excerpt       String
  /// The text search engines show under the page title (70–160 characters). Falls back to the excerpt.
  metaDescription String?
  content       String
  coverPhotoUrl String?
  /// More photos for the article, shown as a gallery under the text. The
  /// cover stays in coverPhotoUrl so cards and share images keep working.
  photoUrls     String[]      @default([])
  readMinutes   Int           @default(5)
  status        ArticleStatus @default(DRAFT)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model ItineraryDay {
  id            String       @id @default(cuid())
  itineraryId   String
  itinerary     Itinerary    @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  dayNumber     Int
  title         String
  description   String?
  destinationId String?
  destination   Destination? @relation(fields: [destinationId], references: [id])
  activities    String[]
  mealsIncluded String[] // e.g. ["Breakfast", "Dinner"]

  lodgingId String?
  lodging   ItineraryLodging? @relation(fields: [lodgingId], references: [id], onDelete: SetNull)

  // Walking/hiking on this day. All optional: a transfer day has none, and
  // a trekking day may know its distance but not its elevation profile.
  // Distances are kilometres and ascent/descent metres — the site's other
  // measurements are metric, and converting for display is the UI's job.
  hikeDistanceKm Decimal?        @db.Decimal(5, 1)
  hikeAscentM    Int?
  hikeDescentM   Int?
  hikeHours      Decimal?        @db.Decimal(3, 1)
  hikeDifficulty TripDifficulty? // the day's own level, which can differ from the trip's
  hikeNote       String? // e.g. "shorter valley option available"

  @@unique([itineraryId, dayNumber])
}

// A traveler's booking of a fixed package (ITINERARY-type Booking). Starts
// PENDING like guide/hotel/vehicle bookings — package tours need the
// agency to actually assign a guide, hotels, and transport before
// confirming, unlike a flight's synchronous ticketing.
model ItineraryBooking {
  id          String    @id @default(cuid())
  bookingId   String    @unique
  booking     Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  itineraryId String
  itinerary   Itinerary @relation(fields: [itineraryId], references: [id])
  travelers   Int       @default(1)
  notes       String?
  createdAt   DateTime  @default(now())
}

// ---------------------------------------------------------------------------
// Custom tour requests — a traveler describes what they want (destinations,
// dates, group size, budget) and the agency follows up with a bespoke
// quote. Not a booking: no fixed itinerary or price exists yet.
// ---------------------------------------------------------------------------

enum CustomTourRequestStatus {
  NEW
  IN_REVIEW
  QUOTED
  CLOSED
}

model CustomTourRequest {
  id              String                  @id @default(cuid())
  travelerId      String
  traveler        User                    @relation(fields: [travelerId], references: [id], onDelete: Cascade)
  startDate       DateTime
  endDate         DateTime
  travelers       Int                     @default(1)
  budgetPerPerson Decimal?                @db.Decimal(10, 2)
  notes           String?
  status          CustomTourRequestStatus @default(NEW)
  adminNote       String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  // Traveler's self-service picks — all optional ("no preference" is valid).
  // The server recomputes pricing from these vendors' real rates rather than
  // trusting a client-sent total.
  guideId     String?
  guide       GuideProfile? @relation(fields: [guideId], references: [id])
  roomTypeId  String?
  roomType    RoomType?     @relation(fields: [roomTypeId], references: [id])
  roomsNeeded Int?
  vehicleId   String?
  vehicle     Vehicle?      @relation(fields: [vehicleId], references: [id])

  estimatedTotalPrice     Decimal? @db.Decimal(10, 2)
  estimatedPricePerPerson Decimal? @db.Decimal(10, 2)

  destinations Destination[] @relation("CustomTourDestinations")
}

enum PaymentMethod {
  BANK_TRANSFER
  MOBILE_WALLET
  CASH
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  FAILED
}

model Payment {
  id               String        @id @default(cuid())
  bookingId        String        @unique
  booking          Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  amount           Decimal       @db.Decimal(10, 2)
  commissionAmount Decimal       @db.Decimal(10, 2)
  method           PaymentMethod
  status           PaymentStatus @default(PENDING)
  reference        String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

enum ReviewTargetType {
  GUIDE
  HOTEL
  VEHICLE
  ITINERARY
}

model Review {
  id         String           @id @default(cuid())
  bookingId  String           @unique // one review per completed booking — prevents fake/unlinked reviews
  booking    Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  travelerId String
  traveler   User             @relation(fields: [travelerId], references: [id], onDelete: Cascade)
  targetType ReviewTargetType
  targetId   String // GuideProfile.id | Hotel.id | Vehicle.id | Itinerary.id
  rating     Int // 1-5
  comment    String?
  createdAt  DateTime         @default(now())

  @@index([targetType, targetId])
}

model Message {
  id        String   @id @default(cuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([bookingId, createdAt])
}

// ---------------------------------------------------------------------------
// GPS tracking module
//
// Pipeline: physical GPS unit -> Traccar server (or vendor API/webhook) ->
// POST /api/gps/ingest -> GpsPosition rows, linked to the vehicle's active
// Trip. Two consumers share this pipeline: the admin mileage-verification
// report, and the traveler/public live-tracking view.
// ---------------------------------------------------------------------------

enum GpsDeviceStatus {
  ACTIVE
  INACTIVE
}

model GpsDevice {
  id               String          @id @default(cuid())
  vehicleId        String          @unique
  vehicle          Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  deviceIdentifier String          @unique // Traccar device "uniqueId" (e.g. IMEI) or vendor-platform device id
  protocol         String? // Traccar protocol name, once the hardware model is confirmed
  status           GpsDeviceStatus @default(ACTIVE)
  createdAt        DateTime        @default(now())

  positions GpsPosition[]
}

enum TripStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

model Trip {
  id        String     @id @default(cuid())
  bookingId String     @unique
  booking   Booking    @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  vehicleId String
  vehicle   Vehicle    @relation(fields: [vehicleId], references: [id])
  status    TripStatus @default(NOT_STARTED)

  // Planned route, captured at booking time, used as the baseline to compare
  // GPS-verified actual distance against.
  plannedDistanceKm Float
  plannedRoute      Json // [{ lat, lng, label? }, ...] waypoints

  startedAt DateTime?
  endedAt   DateTime?

  // Public shareable link for live tracking (no account required).
  shareToken String @unique @default(cuid())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  positions GpsPosition[]
  report    TripDistanceReport?

  @@index([vehicleId, status])
}

model GpsPosition {
  id         String    @id @default(cuid())
  deviceId   String
  device     GpsDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  tripId     String?
  trip       Trip?     @relation(fields: [tripId], references: [id], onDelete: SetNull)
  latitude   Float
  longitude  Float
  speedKmh   Float?
  heading    Float?
  recordedAt DateTime // timestamp reported by the device
  receivedAt DateTime  @default(now()) // timestamp the platform received it (for connectivity-gap diagnostics)

  @@index([tripId, recordedAt])
  @@index([deviceId, recordedAt])
}

// Cached, generated report comparing planned vs GPS-verified actual distance
// for a completed trip. Regenerated whenever a trip is ended/recomputed.
model TripDistanceReport {
  id                String   @id @default(cuid())
  tripId            String   @unique
  trip              Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  actualDistanceKm  Float
  plannedDistanceKm Float
  deviationKm       Float
  deviationPercent  Float
  flagged           Boolean // true if deviation exceeds the dispute threshold
  flagReason        String?
  startLatitude     Float?
  startLongitude    Float?
  endLatitude       Float?
  endLongitude      Float?
  pointCount        Int
  generatedAt       DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Currency display — travelers can browse prices in USD/AUD/INR/EUR/GBP.
// BTN stays the real transactional currency everywhere else in the app;
// this table only feeds the display conversion.
// ---------------------------------------------------------------------------

// One row per non-BTN currency we display. btnPerUnit = how many BTN equal
// one unit of that currency, refreshed automatically by a scheduled job
// (see /api/cron/fx-rates) from a live rate source, so it tracks the real
// market rate up or down without a code change.
model ExchangeRate {
  currency   String   @id // "USD" | "AUD" | "INR" | "EUR" | "GBP"
  btnPerUnit Decimal  @db.Decimal(12, 4)
  source     String // where this value came from, e.g. "frankfurter.app" or "manual"
  updatedAt  DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Contact / enquiry messages from the public site.
//
// Deliberately NOT tied to a User: the whole point is that someone can ask a
// question before creating an account. `travelerId` is filled in only when a
// signed-in user happens to submit the form, so staff can see the context.
// ---------------------------------------------------------------------------

enum ContactMessageStatus {
  NEW
  IN_PROGRESS
  CLOSED
}

model ContactMessage {
  id          String               @id @default(cuid())
  name        String
  email       String
  phone       String?
  subject     String?
  message     String
  status      ContactMessageStatus @default(NEW)
  adminNote   String?
  travelerId  String?
  traveler    User?                @relation(fields: [travelerId], references: [id], onDelete: SetNull)
  /// Set when the enquiry came from "Request to book" on a specific
  /// departure. Kept as a relation rather than parsed out of `subject`, so
  /// staff see the real departure even if the subject line is edited.
  departureId String?
  departure   Departure?           @relation(fields: [departureId], references: [id], onDelete: SetNull)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  replies     ContactReply[]

  @@index([status, createdAt])
}

/// An email the agency sent back to someone who enquired, written from the
/// admin dashboard. Kept so the team can see what was already said — and by
/// whom — before answering again, and whether the email actually went out.
model ContactReply {
  id        String         @id @default(cuid())
  messageId String
  message   ContactMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  subject   String
  body      String
  toEmail   String
  sentById  String?
  sentBy    User?          @relation(fields: [sentById], references: [id], onDelete: SetNull)
  /// SENT, or FAILED when the mail server refused it (the text is still kept).
  status    String
  error     String?
  /// A price quoted in the email: { label, amount, basis, travelers, validUntil, note }.
  quote     Json?
  /// What was attached: [{ name, kind }] — names only, the files are not kept.
  attachments Json?
  createdAt DateTime       @default(now())

  @@index([messageId, createdAt])
}

// ---------------------------------------------------------------------------
// AI travel assistant — anonymous, session-scoped conversation memory.
//
// This is NOT a CRM and NOT tied to User by design: a visitor can open the
// assistant, chat, browse other pages, and come back to the same
// conversation purely by holding onto its id (the way /track/[token] holds a
// share link, not the way a login session works) — no account, no customer
// profile. `lastMessageAt` exists so a future cleanup job can find and purge
// conversations nobody has touched in a while without needing a separate
// expiry table.
// ---------------------------------------------------------------------------

enum AiMessageRole {
  USER
  ASSISTANT
}

model AiConversation {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  lastMessageAt DateTime @default(now())

  messages AiMessage[]

  @@index([lastMessageAt])
}

model AiMessage {
  id             String         @id @default(cuid())
  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           AiMessageRole
  content        String
  createdAt      DateTime       @default(now())

  @@index([conversationId, createdAt])
}

// ---------------------------------------------------------------------------
// AI Phase 2 — RAG / knowledge layer.
//
// Deliberately separate from the structured booking data above: a Package,
// Guide, Hotel, etc. already have a canonical home in this schema and the
// assistant already retrieves them directly (see src/lib/ai/tools.ts) — this
// section exists only for knowledge that doesn't fit a relational model
// (FAQs, policies, visa guidance, uploaded documents) plus indexed copies of
// content that does (published Articles), for semantic search.
//
// Multi-tenant only here, not retrofitted onto the models above: this app
// has only ever served one agency, and adding a tenant column to eight+
// live production models is a much bigger, riskier change than this phase
// calls for. `Agency` exists so this new layer is built tenant-aware from
// day one; the older structured-data tools stay implicitly single-tenant
// (whatever's in this database) until a future phase actually needs to
// serve more than one agency from the same deployment.
// ---------------------------------------------------------------------------

model Agency {
  id        String   @id @default(cuid())
  /**
   * Stable machine identifier, e.g. "droelma" — the only tenant that
   * exists today. Never derived from user/browser input.
   */
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())

  documents KnowledgeDocument[]
}

enum KnowledgeVisibility {
  PUBLIC
  INTERNAL
}

enum KnowledgeSourceType {
  MANUAL // hand-authored knowledge (e.g. a rewritten FAQ answer)
  ARTICLE // indexed copy of a published Article's content
  FAQ
  POLICY
  UPLOAD // future: an uploaded document (TXT/MD now; PDF/DOCX not yet — see report)
  PACKAGE // indexed copy of a published Itinerary — its days, stays and inclusions
  DESTINATION // indexed copy of a Destination — its description and highlights
}

enum KnowledgeStatus {
  DRAFT
  PUBLISHED
}

model KnowledgeDocument {
  id         String              @id @default(cuid())
  agencyId   String
  agency     Agency              @relation(fields: [agencyId], references: [id])
  title      String
  /**
   * Full plain text — the source of truth chunks are derived from.
   */
  content    String
  sourceType KnowledgeSourceType
  /**
   * Where this came from, if applicable — e.g. the originating Article's
   * slug, or an uploaded file's original name. Not a foreign key: sources
   * span different models (or no model at all, for hand-authored text).
   */
  sourceRef  String?
  category   String?
  visibility KnowledgeVisibility @default(PUBLIC)
  status     KnowledgeStatus     @default(DRAFT)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  chunks KnowledgeChunk[]

  @@index([agencyId, status, visibility])
}

model KnowledgeChunk {
  id         String                      @id @default(cuid())
  documentId String
  document   KnowledgeDocument           @relation(fields: [documentId], references: [id], onDelete: Cascade)
  // Denormalized from the parent document on purpose. Retrieval is the
  // security-critical path here — it must never surface another agency's
  // knowledge, or INTERNAL knowledge to an anonymous visitor — so the
  // chunk row itself carries everything a retrieval query needs to filter
  // on, rather than trusting a join back to KnowledgeDocument to be
  // written correctly every time.
  agencyId   String
  visibility KnowledgeVisibility
  content    String
  chunkIndex Int
  /**
   * pgvector column. Prisma's typed client can't construct or filter an
   * `Unsupported` type, so every read/write of this column goes through
   * raw SQL (see src/lib/ai/retrieval.ts) — this field exists mainly so
   * `prisma db pull`/introspection and migration history stay accurate.
   * Dimension is tied to the embedding model (nomic-embed-text, 768) —
   * changing models means re-embedding every row, not just this schema.
   */
  embedding  Unsupported("vector(768)")?
  createdAt  DateTime                    @default(now())

  @@index([agencyId, visibility])
}

/// Editable site copy, one row per field.
///
/// A flat key/value store rather than a column per piece of text: the set of
/// editable fields changes whenever a section is added or reworded, and a
/// migration per wording change is not a workable way to run a website. The
/// authoritative list of fields — their keys, labels, input types and
/// defaults — lives in src/lib/content/registry.ts, which also supplies the
/// fallback when a row is absent. That means a missing row renders the
/// designed default rather than an empty page, and adding a new editable
/// field needs no migration at all.
model SiteContent {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
  updatedBy String?
}

/// A numbered clause or Q&A pair on an editable long-form page.
///
/// Separate from SiteContent because these are lists the client adds to and
/// reorders, not a fixed set of named fields — a registry key per clause
/// would mean a code change every time a lawyer adds one. `group` carries
/// the FAQ's category heading and is null for legal pages.
///
/// `body` is the small markup understood by src/components/RichText.tsx
/// (paragraphs, bullets, bold, links, and ==pending confirmation== marks).
/// It is never rendered as HTML, so there is nothing to sanitise.
model ContentSection {
  id        String   @id @default(cuid())
  page      String
  group     String?
  heading   String
  body      String
  position  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([page, position])
}

/// A scheduled departure of a package tour — one set of dates travellers can
/// ask to join.
///
/// Availability is a status the agency sets rather than a seat count derived
/// from enquiries. An enquiry is an expression of interest, not a held seat,
/// so counting them would overstate how full a trip is; staff know what is
/// actually committed and say so here.
///
/// `endDate` is stored rather than computed from the itinerary's duration so
/// a one-off departure can run long or short (a festival date, a shortened
/// shoulder-season run) without editing the package itself.
model Departure {
  id            String          @id @default(cuid())
  itineraryId   String
  itinerary     Itinerary       @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  startDate     DateTime        @db.Date
  endDate       DateTime        @db.Date
  /// Per-person price for this departure when it differs from the package's
  /// standard price — peak festival weeks, for instance. Null means the
  /// package price applies.
  priceOverride Decimal?        @db.Decimal(10, 2)
  status        DepartureStatus @default(OPEN)
  /// Short public label, e.g. "Thimphu Tshechu" — shown beside the dates.
  note          String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  enquiries ContactMessage[]

  @@index([itineraryId, startDate])
}

enum DepartureStatus {
  OPEN
  LIMITED
  SOLD_OUT
  CANCELLED
}
