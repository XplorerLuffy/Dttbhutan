# Copy this file to .env and fill in real values for local development.

# PostgreSQL connection string. On Supabase this should be the pooled
# (PgBouncer, port 6543) connection string — it's what the app's serverless
# functions use for every normal query.
DATABASE_URL="postgresql://dttbhutan:dttbhutan_dev@localhost:5432/dttbhutan"

# Direct (non-pooled) connection, used only by `prisma migrate deploy`/`dev`.
# On Supabase this is the port-5432 connection against db.<project-ref>.supabase.co
# (same password as DATABASE_URL, different host/port/username) — migrations
# take a session-level advisory lock that a transaction-mode pooler can hang
# on forever. Locally there's no pooler, so this is identical to DATABASE_URL.
DIRECT_URL="postgresql://dttbhutan:dttbhutan_dev@localhost:5432/dttbhutan"

# Secret used to sign session JWTs. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-32-byte-secret"

# --- GPS tracking (Traccar) ---------------------------------------------
# Base URL of the self-hosted Traccar server's REST API, once deployed.
# See docs/gps-integration.md for setup notes and the /api/gps/ingest
# webhook contract this app expects from Traccar's forwarding config.
TRACCAR_API_URL="http://localhost:8082/api"
TRACCAR_API_USER=""
TRACCAR_API_PASSWORD=""

# Shared secret Traccar's "Forwarding" feature (or a bridging script) must
# send as the `x-ingest-secret` header when POSTing positions to
# /api/gps/ingest. Generate with: openssl rand -hex 24
GPS_INGEST_SECRET="replace-with-a-random-secret"

# Deviation threshold (%) above which a trip's actual vs. planned distance
# is flagged for admin review in mileage-verification reports.
GPS_DEVIATION_FLAG_PERCENT="15"

# --- Currency display -------------------------------------------------------
# Shared secret for /api/cron/fx-rates (the daily job that refreshes
# USD/AUD/EUR/GBP display rates from a live source). Vercel Cron sends this
# automatically as an Authorization header once set as a project env var.
# Generate with: openssl rand -hex 24
CRON_SECRET="replace-with-a-random-secret"

# --- Photo storage ----------------------------------------------------------
# Vercel Blob read/write token. Set this in production — without it uploads
# fall back to local disk, which does NOT survive a redeploy on Vercel (every
# uploaded photo is silently lost). Get it from the Vercel dashboard:
# Storage → create a Blob store → connect it to this project, which sets this
# variable automatically.
BLOB_READ_WRITE_TOKEN=""

# --- Transactional email ----------------------------------------------------
# Resend API key (https://resend.com → API Keys). Without it the app still
# works: every notification is logged to the server console instead of being
# sent, so local dev needs no account and nothing breaks before setup.
RESEND_API_KEY=""

# The From address on outgoing mail. The domain here must be verified in
# Resend (add its SPF + DKIM DNS records) or mail will be rejected/spammed.
EMAIL_FROM="Droelma Tours & Travels <bookings@yourdomain.bt>"

# Where "someone just booked / enquired" alerts go — the agency's own inbox.
# Leave blank to skip agency alerts (travelers and vendors are still notified).
AGENCY_NOTIFICATION_EMAIL=""

# Absolute base URL used for links inside emails. Set this per environment so
# a confirmation email from production never links to a preview deploy.
NEXT_PUBLIC_SITE_URL="https://dttbhutan.vercel.app"

# --- AI travel assistant ----------------------------------------------------
# Selects the LLM backend for /api/chat (src/lib/ai/provider.ts): "ollama",
# "anthropic" or "gemini". Adding another means one file under
# src/lib/ai/providers/ and one more case in the factory there — not
# touching /api/chat. This var is what makes that swap a config change, not
# a code change.
#
# ⚠️ Leaving this unset defaults to "ollama", whose base URL is localhost.
# On Vercel that resolves to the serverless function itself, so every chat
# request fails and the visitor gets "temporarily unavailable". A hosted
# deployment must set this explicitly — that unset default is exactly why
# production stored visitor questions with no assistant reply for months.
AI_PROVIDER="ollama"

# Where the Ollama server lives and which model to call. The default
# assumes Ollama running locally (`ollama serve`) with `ollama pull
# llama3.2` already done. Server-side only — never read by browser code.
#
# For a hosted deployment, point this at Ollama's own service instead:
#   OLLAMA_BASE_URL="https://ollama.com"
#   OLLAMA_API_KEY="…"          # https://ollama.com/settings/keys
# It speaks the same paths and request bodies, so nothing else changes. This
# is what makes AI_PROVIDER="ollama" viable on Vercel, where the localhost
# default resolves to the function itself.
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2"

# Only needed when OLLAMA_BASE_URL points at a host that requires auth (the
# hosted service does; a local server ignores it). Sent as an Authorization:
# Bearer header — per Ollama's docs `x-api-key` alone is not accepted. These
# keys do not expire; revoke one at https://ollama.com/settings/keys.
# Shared by the chat and embedding providers, which must use the same server.
OLLAMA_API_KEY=""

# Only needed when AI_PROVIDER="anthropic" — a hosted alternative to local
# Ollama (e.g. for an environment where Ollama isn't reachable, or for
# production before a permanent hosted provider is decided). Get a key from
# https://console.anthropic.com/settings/keys. Never exposed to the browser.
ANTHROPIC_API_KEY=""

# Only needed when AI_PROVIDER="gemini" — Google's free-tier-friendly
# alternative (no card required for a Google AI Studio key). Get one from
# https://aistudio.google.com/apikey. Never exposed to the browser. The same
# key serves EMBEDDING_PROVIDER="gemini" below; one key covers both.
#
# Free-tier quotas are low enough to matter in production: a handful of
# requests per minute, and one chat turn costs two or more calls because the
# model calls a tool and then answers. The app's own limiter (8/min per IP,
# src/lib/ai/rateLimit.ts) is looser than that, so a couple of simultaneous
# visitors can exhaust the quota and get "temporarily unavailable" — a 429
# surfaces as a clean 503, not a crash, but it is still a dead reply.
# Enable billing on the Google Cloud project behind the key before the site
# takes real traffic.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.6-flash"

# --- AI knowledge base (RAG) ----------------------------------------------
# Embeddings are a separate service from chat: a deployment can reasonably
# run a local embedding model alongside a hosted chat model. Either
# "ollama" (local) or "gemini" (hosted, reuses GEMINI_API_KEY).
#
# ⚠️ On Vercel this MUST be "gemini". Ollama's base URL is localhost, which
# on a serverless function is the function itself — nothing answers there,
# so every query embedding fails and retrieval silently degrades to text
# search. That still returns answers, but ranks worse than vector search.
EMBEDDING_PROVIDER="ollama"

# Must emit 768-dimensional vectors — that's what KnowledgeChunk.embedding
# is declared as (vector(768)) in prisma/schema.prisma. Changing to a model
# of different width requires a schema migration AND re-embedding every
# existing chunk, so it isn't a drop-in swap.
#
#   ollama → "nomic-embed-text" (768 native; needs `ollama pull nomic-embed-text`)
#   gemini → "gemini-embedding-001" (asked for at 768 via outputDimensionality)
#
# Both sides of a search must use the SAME model: a query embedded by one
# model and chunks embedded by another are not comparable, and the results
# are quietly nonsense rather than an error. Switching means re-ingesting.
EMBEDDING_MODEL="nomic-embed-text"

# Which agency's knowledge this deployment serves. The knowledge layer is
# built tenant-aware (every document and chunk carries an agencyId, and
# retrieval filters on it in SQL) even though only one tenant exists today.
# Resolved server-side only — never accepted from the browser.
AGENCY_SLUG="droelma"
AGENCY_NAME="Droelma Tours & Travels"

# --- Payments -------------------------------------------------------------
# Placeholder only — no gateway is wired up yet. Confirm with the client
# which of these are viable in Bhutan (bank transfer reference numbers are
# recorded manually by staff today; mobile wallet / card gateway TBD).
PAYMENT_GATEWAY="manual"
