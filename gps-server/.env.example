# Copy to .env on the server (chmod 600). Never commit the real file.

# Where positions go. Must be https:// unless it is localhost.
GPS_INGEST_URL=https://dttbhutan.com/api/gps/ingest
# Must equal GPS_INGEST_SECRET on Vercel.
GPS_INGEST_SECRET=change-me
# Server-only secret that device authentication codes are derived from.
# At least 24 random characters; different from GPS_INGEST_SECRET.
GPS_DEVICE_AUTH_SECRET=change-me-to-a-long-random-string

GPS_LISTEN_HOST=0.0.0.0
GPS_LISTEN_PORT=8808
# Monitoring port: keep it on localhost.
GPS_HEALTH_HOST=127.0.0.1
GPS_HEALTH_PORT=8809
# GPS_STATUS_TOKEN=optional-bearer-token-for-/status

# Limits (defaults shown)
# GPS_MAX_CONNECTIONS=500
# GPS_MAX_CONNECTIONS_PER_IP=20
# GPS_AUTH_TIMEOUT_MS=30000
# GPS_IDLE_TIMEOUT_MS=300000
# GPS_MAX_MESSAGES_PER_SECOND=20

# The spec says device clocks are GMT+8 (480 minutes). Confirm on a real device.
# GPS_DEVICE_TZ_OFFSET_MINUTES=480
# GPS_MAX_FUTURE_SKEW_SECONDS=600
# GPS_MAX_POSITION_AGE_DAYS=30
LOG_LEVEL=info
